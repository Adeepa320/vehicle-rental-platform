# ============================================================================
# Local development environment — copy to `.env` (git-ignored) and adjust.
# This single file is read by: Docker Compose (via defaults), the database
# scripts (migrate/seed), the API and the worker. The web app has its own
# file: apps/web/.env.example -> apps/web/.env.local
# Never put real production secrets in this file.
# ============================================================================

# ---- Docker Compose (infra/docker-compose.yml) -----------------------------
# Compose uses these defaults even if .env is absent. To change ports,
# run: docker compose --env-file .env -f infra/docker-compose.yml up -d
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=vehicle_rental
DB_PORT=5432
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
# MinIO root credentials (local development only; the API uses the same values below).
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# ---- Database (packages/database, apps/api, worker) ------------------------
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/vehicle_rental
# Separate database used by automated tests (created by infra/db/init on first start).
DATABASE_URL_TEST=postgresql://postgres:postgres@localhost:5432/vehicle_rental_test

# ---- API (apps/api) ---------------------------------------------------------
NODE_ENV=development
API_PORT=4000
API_HOST=0.0.0.0
# Comma-separated list of allowed browser origins (CORS + CSRF origin check).
CORS_ORIGINS=http://localhost:3000
# Public URL of the web app; used in e-mail links.
WEB_APP_URL=http://localhost:3000
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=debug
# Global rate limit: RATE_LIMIT_MAX requests per RATE_LIMIT_TTL_SECONDS per client IP.
RATE_LIMIT_TTL_SECONDS=60
RATE_LIMIT_MAX=300
# Auth-specific limits (per IP unless stated).
AUTH_LOGIN_LIMIT_PER_MINUTE=10
AUTH_SENSITIVE_LIMIT_PER_15MIN=5
AUTH_TOKEN_REQUESTS_PER_USER_PER_15MIN=3
# Swagger UI at http://localhost:4000/api/docs (defaults to on outside production).
OPENAPI_ENABLED=true

# ---- Sessions & tokens ------------------------------------------------------
JWT_ISSUER=vrp-api
JWT_AUDIENCE=vrp
# Ed25519 PEM keys, single line with \n escapes. Generate with:
#   pnpm --filter @vrp/api keys:generate
# Optional in development/test (an ephemeral pair is generated per process);
# REQUIRED in production.
# JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
# Refresh cookie: Secure defaults to true in production (localhost is treated as secure by browsers).
# COOKIE_SECURE=true
# COOKIE_DOMAIN=
EMAIL_VERIFICATION_TTL_HOURS=24
PASSWORD_RESET_TTL_MINUTES=30

# ---- Password hashing (Argon2id) -------------------------------------------
ARGON2_MEMORY_KIB=65536
ARGON2_TIME_COST=3

# ---- E-mail delivery --------------------------------------------------------
# smtp -> Mailpit locally (UI at http://localhost:8025); any SMTP server in production.
EMAIL_PROVIDER=smtp
EMAIL_FROM="Vehicle Rental Platform <no-reply@localhost>"
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# Optional: operator inbox that receives a notice when a provider application is submitted.
# Leave empty to disable. Delivered through the same SMTP settings (Mailpit locally).
# OPERATOR_NOTIFICATION_EMAIL=ops@localhost

# ---- Object storage (apps/api; MinIO locally, any S3-compatible service later) ----
# s3 -> MinIO at STORAGE_ENDPOINT (console at http://localhost:9001); memory -> tests only.
STORAGE_PROVIDER=s3
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_BUCKET_PRIVATE=vrp-private
STORAGE_BUCKET_PUBLIC=vrp-public
# Base URL the browser uses for processed vehicle photos (public bucket).
STORAGE_PUBLIC_URL=http://localhost:9000/vrp-public
STORAGE_FORCE_PATH_STYLE=true
# Create buckets + public-read policy at startup (defaults to true outside production).
# STORAGE_AUTO_CREATE_BUCKETS=true

# ---- Worker (apps/api, `pnpm dev:worker`) -----------------------------------
# Schema that pg-boss creates for its queue tables.
PGBOSS_SCHEMA=pgboss

# ---- Later phases (NOT read by any code yet) ---------------------------------
# SMS (+94, Notify.lk/Text.lk): SMS_PROVIDER= SMS_API_KEY= SMS_SENDER_ID=
# Payments (PayHere):        PAYHERE_MERCHANT_ID= PAYHERE_MERCHANT_SECRET= PAYHERE_SANDBOX=true
# Field encryption:          ENCRYPTION_KEY=
# Error tracking:            SENTRY_DSN=
