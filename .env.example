# ============================================================================
# Environment reference — copy to `.env` (git-ignored) for local development.
# One file is read by Docker Compose (defaults), the database scripts, the API
# and the worker. The web app has its own file: apps/web/.env.example.
#
# Each variable is tagged:  [required] [optional] [staging-only] [production-only]
# and grouped as LOCAL (dev defaults), STAGING and PRODUCTION (values that
# must change). Production start-up is refused when a production-only rule is
# violated (apps/api/src/config/env.schema.ts); `pnpm production:check
# --env-file <file>` reports every rule without printing a single value.
# NEVER put real secrets in this file or commit a real .env.
# ============================================================================

# ============================================================================
# LOCAL — development defaults (safe out of the box)
# ============================================================================

# ---- Docker Compose (infra/docker-compose.yml) -----------------------------
# Compose uses these defaults even if .env is absent. To change ports,
# run: docker compose --env-file .env -f infra/docker-compose.yml up -d
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=vehicle_rental
DB_PORT=5432
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
# MinIO root credentials (local development only; refused in production).
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# ---- Database [required] ---------------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/vehicle_rental
# Separate database used by automated tests (created by infra/db/init on first start). [optional]
DATABASE_URL_TEST=postgresql://postgres:postgres@localhost:5432/vehicle_rental_test

# ---- API runtime -----------------------------------------------------------
# development | test | production  [required]
NODE_ENV=development
# staging | production — only meaningful with NODE_ENV=production: `production` requires the live PayHere gateway. [optional]
LAUNCH_MODE=staging
API_PORT=4000
API_HOST=0.0.0.0
# Reverse proxies in front of the API whose X-Forwarded-* / X-Real-IP headers are trusted
# (Express "trust proxy"). 0 locally; 1 behind Railway; 2 behind Cloudflare → Railway. [optional]
TRUST_PROXY_HOPS=0
# Comma-separated browser origins allowed by CORS and the CSRF origin check. [required]
CORS_ORIGINS=http://localhost:3000
# Public URL of the web app (links in e-mails). [required]
WEB_APP_URL=http://localhost:3000
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=debug
# Global per-IP rate limit: RATE_LIMIT_MAX requests per RATE_LIMIT_TTL_SECONDS.
RATE_LIMIT_TTL_SECONDS=60
RATE_LIMIT_MAX=300
# Auth and abuse limits (per IP unless stated).
AUTH_LOGIN_LIMIT_PER_MINUTE=10
AUTH_SENSITIVE_LIMIT_PER_15MIN=5
AUTH_TOKEN_REQUESTS_PER_USER_PER_15MIN=3
# Dispute opens / thread posts per IP per 15 minutes (Phase 9).
THREAD_POSTS_PER_15MIN=30
# Swagger UI at http://localhost:4000/api/docs (defaults to on outside production; refused in production).
OPENAPI_ENABLED=true

# ---- Sessions & tokens -----------------------------------------------------
JWT_ISSUER=vrp-api
JWT_AUDIENCE=vrp
# Ed25519 PEM keys, single line with \n escapes. Generate with:
#   pnpm --filter @vrp/api keys:generate
# Optional in development/test (an ephemeral pair is generated per process); [production-only required]
# JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
# Refresh cookie: Secure (and the __Secure- name prefix) defaults to true in production; cannot be false there.
# COOKIE_SECURE=true
# COOKIE_DOMAIN=
EMAIL_VERIFICATION_TTL_HOURS=24
PASSWORD_RESET_TTL_MINUTES=30
# Strict-Transport-Security; defaults to true in production. [optional]
# HSTS_ENABLED=true

# ---- Application encryption & admin MFA (Phase 10) --------------------------
# AES-256-GCM key for sensitive columns (TOTP secrets): 32 random bytes, base64.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Unset locally = the documented development key (refused in production). [production-only required]
# APP_DATA_ENCRYPTION_KEY=
# Previous key during a rotation (decrypt only; see docs/runbooks/SECRET_ROTATION.md). [optional]
# APP_DATA_ENCRYPTION_KEY_PREVIOUS=
# Privileged (admin / super_admin) routes require a verified authenticator-app factor.
# Defaults to false outside production and to true in production (cannot be disabled there). [optional]
# ADMIN_MFA_REQUIRED=false
# Label shown in authenticator apps. [optional]
MFA_ISSUER=Vehicle Rental Platform

# ---- Password hashing (Argon2id) -------------------------------------------
ARGON2_MEMORY_KIB=65536
ARGON2_TIME_COST=3

# ---- E-mail delivery -------------------------------------------------------
# smtp -> Mailpit locally (UI at http://localhost:8025); any SMTP server in production. memory -> tests only.
EMAIL_PROVIDER=smtp
EMAIL_FROM="Vehicle Rental Platform <no-reply@localhost>"
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
# Refuse delivery unless STARTTLS upgrades the connection; defaults to true in production. [optional]
# SMTP_REQUIRE_TLS=true
# SMTP_USER=
# SMTP_PASS=
# Operator inbox for application / dispute / privacy-request notices. Empty = disabled. [optional]
# OPERATOR_NOTIFICATION_EMAIL=ops@localhost

# ---- Object storage (MinIO locally; any S3-compatible service in production) --
# s3 (default) | memory (tests only)
STORAGE_PROVIDER=s3
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_BUCKET_PRIVATE=vrp-private
STORAGE_BUCKET_PUBLIC=vrp-public
# Base URL the browser uses for processed vehicle photos (public bucket / CDN).
STORAGE_PUBLIC_URL=http://localhost:9000/vrp-public
STORAGE_FORCE_PATH_STYLE=true
# Create buckets + public-read policy at startup (defaults to true outside production; refused in production).
# STORAGE_AUTO_CREATE_BUCKETS=true

# ---- Worker ----------------------------------------------------------------
# Schema that pg-boss creates for its queue tables.
PGBOSS_SCHEMA=pgboss

# ---- Bookings --------------------------------------------------------------
# HMAC secret for signed price-quote tokens (≥ 32 characters). Optional locally (per-process secret);
# [production-only required]. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# BOOKING_QUOTE_SECRET=
BOOKING_QUOTE_TTL_MINUTES=15
# Timers, reveal stage, cancellation threshold, retention periods and the money pair are platform
# settings in the database (table platform_settings, edited at /admin/settings), not environment variables.

# ---- Payments --------------------------------------------------------------
# Public base URL of this API as the gateway and browsers reach it (notify_url default, fake checkout page).
API_PUBLIC_URL=http://localhost:4000/api/v1
# fake (local simulator on the same PayHere code path; refused in production) | payhere
PAYMENT_GATEWAY=fake
# sandbox -> sandbox.payhere.lk, live -> www.payhere.lk (LAUNCH_MODE=production requires live)
PAYHERE_ENVIRONMENT=sandbox
# Required when PAYMENT_GATEWAY=payhere (merchant portal; the secret is bound to the registered domain). NEVER commit real values.
# PAYHERE_MERCHANT_ID=
# PAYHERE_MERCHANT_SECRET=
# Publicly reachable notify URL; defaults to API_PUBLIC_URL + /payments/payhere/notify. [production-only required]
# PAYHERE_NOTIFY_URL=
# Merchant API (Retrieval / Refund) app credentials. Without them reconcile and gateway refunds answer 503. [optional]
# PAYHERE_APP_ID=
# PAYHERE_APP_SECRET=

# ---- Observability (Phase 10) ----------------------------------------------
# Sentry-compatible DSN for error reporting; unset = no-op. Events carry no headers, cookies, bodies or addresses. [optional]
# SENTRY_DSN=
# Release identifier (git SHA) attached to logs and error events. [optional]
# APP_RELEASE=

# ============================================================================
# STAGING — same shape as production with sandbox money (LAUNCH_MODE=staging)
# Full matrix, secrets, dashboard steps: docs/runbooks/STAGING_DEPLOYMENT.md (TECH_DECISIONS D77).
# Set these as Railway variables (secrets Sealed); never in a committed file.
# ============================================================================
# NODE_ENV=production            LAUNCH_MODE=staging         TRUST_PROXY_HOPS=1 (Railway) or 2 (Cloudflare → Railway)
# DATABASE_URL=<Neon DIRECT endpoint, no -pooler host>?sslmode=require   (staging project only; API, worker and migrator)
# CORS_ORIGINS=https://staging.<domain>   WEB_APP_URL=https://staging.<domain>   API_PUBLIC_URL=https://api.staging.<domain>/api/v1
# Web and API must share a registrable domain for the refresh cookie: two *.up.railway.app hosts do not (public suffix).
# ADMIN_MFA_REQUIRED=true  MFA_ISSUER="Vehicle Rental Platform STAGING"  APP_RELEASE=<git sha>  RAILWAY_DEPLOYMENT_DRAINING_SECONDS=15
# JWT_PRIVATE_KEY / JWT_PUBLIC_KEY / BOOKING_QUOTE_SECRET / APP_DATA_ENCRYPTION_KEY = staging-only secrets
# EMAIL_PROVIDER=smtp  SMTP_HOST=smtp.resend.com  SMTP_PORT=587  SMTP_USER=resend  SMTP_PASS=<key>  EMAIL_FROM="… <no-reply@staging.<domain>>"
# STORAGE_ENDPOINT=https://<account>.r2.cloudflarestorage.com  STORAGE_PUBLIC_URL=https://img-staging.<domain>  (staging buckets)
# PAYMENT_GATEWAY=payhere  PAYHERE_ENVIRONMENT=sandbox  PAYHERE_MERCHANT_ID / PAYHERE_MERCHANT_SECRET = sandbox  PAYHERE_NOTIFY_URL=https://api.staging.<domain>/api/v1/payments/payhere/notify
# OPENAPI_ENABLED is ignored (never served in production builds); LOG_LEVEL=info

# ============================================================================
# PRODUCTION — every value below is validated at start-up and by production:check
# ============================================================================
# NODE_ENV=production            LAUNCH_MODE=production       TRUST_PROXY_HOPS=2 (Cloudflare → Railway)
# CORS_ORIGINS=https://<domain>  WEB_APP_URL=https://<domain> API_PUBLIC_URL=https://api.<domain>/api/v1   (https, no localhost)
# JWT_PRIVATE_KEY / JWT_PUBLIC_KEY       [required]  COOKIE_SECURE must not be false   HSTS_ENABLED defaults true
# BOOKING_QUOTE_SECRET                   [required]  ≥ 32 chars
# APP_DATA_ENCRYPTION_KEY                [required]  not the development key
# ADMIN_MFA_REQUIRED                     forced true
# EMAIL_PROVIDER=smtp  SMTP_HOST=smtp.resend.com  SMTP_PORT=587  SMTP_USER=resend  SMTP_PASS=<key>  SMTP_REQUIRE_TLS=true  EMAIL_FROM="… <no-reply@<domain>>"
# STORAGE_PROVIDER=s3  STORAGE_ENDPOINT=https://<account>.r2.cloudflarestorage.com  STORAGE_ACCESS_KEY / STORAGE_SECRET_KEY (scoped token)
# STORAGE_PUBLIC_URL=https://img.<domain>  STORAGE_AUTO_CREATE_BUCKETS=false (buckets managed by the operator)
# PAYMENT_GATEWAY=payhere  PAYHERE_ENVIRONMENT=live  PAYHERE_MERCHANT_ID / PAYHERE_MERCHANT_SECRET (per registered domain)
# PAYHERE_NOTIFY_URL=https://api.<domain>/api/v1/payments/payhere/notify (must never sit behind a browser challenge)
# PAYHERE_APP_ID / PAYHERE_APP_SECRET    [optional]  Merchant API (refunds / reconciliation; live needs IP allow-listing)
# OPERATOR_NOTIFICATION_EMAIL=ops@<domain>  SENTRY_DSN=<dsn>  APP_RELEASE=<git sha>  LOG_LEVEL=info
