# Copy to apps/web/.env.local (git-ignored). Next.js only reads env files from its own directory.

# Base URL of the API as seen from the browser. Inlined at build time. Its origin is also
# allowed by the Content-Security-Policy (connect-src, form-action for the fake gateway).
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# Base URL used by server components during rendering. Locally identical to the
# public URL; in production it can point at an internal address.
API_INTERNAL_URL=http://localhost:4000/api/v1

# Canonical public URL of this web app (no trailing slash). Used for <link rel="canonical">,
# Open Graph URLs, robots.txt and sitemap.xml. Set it to the real domain in production.
NEXT_PUBLIC_WEB_URL=http://localhost:3000

# MapLibre style URL (free OpenFreeMap tiles by default; no API key). Any MapLibre style JSON works.
# Its origin is always added to NEXT_PUBLIC_MAP_ORIGINS automatically.
NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty

# Comma-separated origins (scheme://host[:port]) that may serve listing photos, added to the
# CSP img-src. Locally this is MinIO; in production the public photo CDN / bucket origin.
NEXT_PUBLIC_IMAGE_ORIGINS=http://localhost:9000

# Comma-separated origins the map may fetch styles, tiles, sprites and glyphs from (CSP
# connect-src). Add every host referenced by the style JSON above.
NEXT_PUBLIC_MAP_ORIGINS=https://tiles.openfreemap.org

# Public contact addresses shown on the site and required by `pnpm production:check` for a
# production web environment (support inbox; privacy / data-subject requests).
NEXT_PUBLIC_SUPPORT_EMAIL=support@localhost
NEXT_PUBLIC_PRIVACY_CONTACT_EMAIL=privacy@localhost
